# Copy to .env (or set the same keys in Coolify). Do not commit real secrets.

# Realm shown to clients (usually your TURN hostname)
TURN_REALM=turn.example.com

# Long-term credentials (lt-cred-mech). Use the same values in each app that uses this relay
# as TURN_USERNAME and TURN_CREDENTIAL.
TURN_USERNAME=oollspace
TURN_PASSWORD=change-me-to-a-long-random-secret

# Public IPv4 of this host. Leave blank to auto-detect at start (best-effort).
# On a VPS behind 1:1 NAT, set the public address explicitly, optionally as
# EXTERNAL_IP=public/private  (coturn's "external-ip" form).
EXTERNAL_IP=

# Listening ports
LISTEN_PORT=3478
TLS_PORT=5349

# UDP relay range (open this range on the firewall; smaller is fine)
MIN_PORT=49152
MAX_PORT=49999

# Optional TLS for turns: (paths inside the container, default /certs/...)
# Mount a host or Coolify volume with fullchain.pem and privkey.pem onto /certs.
# TURN_CERT=/certs/fullchain.pem
# TURN_KEY=/certs/privkey.pem
TURN_CERT=
TURN_KEY=

# Optional quotas
USER_QUOTA=12
TOTAL_QUOTA=1200
